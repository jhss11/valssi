// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int              @id @default(autoincrement())
  username      String           @unique
  email         String           @unique
  password      String
  role          Role             @default(USER)
  lastLogin     DateTime?
  reviews       Review[]
  orders        Order[]
  statusChanges OrderStatusLog[] @relation("AdminChanges")
  moderationRequests ReviewModerationRequest[]
}


enum Role {
  ADMIN
  USER
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  description    String
  price          Float
  createdAt      DateTime               @default(now()) 
  stock          Int
  averageRating  Float           @default(0)
  images         Image[]
  category       Category        @relation(fields: [categoryId], references: [id])
  categoryId     Int
  tags           Tag[]
  reviews        Review[]
  customProducts CustomProduct[]
  orderItems     OrderItem[]
  isDeleted      Boolean         @default(false)
  promotions     Promotion[]
}

model Image {
  id        Int     @id @default(autoincrement())
  url       String
  product   Product @relation(fields: [productId], references: [id])
  productId Int
}

model Category {
  id        Int         @id @default(autoincrement())
  name      String
  products  Product[]
  promotions Promotion[]
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

model ReviewModerationRequest {
  id         Int      @id @default(autoincrement())
  review     Review   @relation(fields: [reviewId], references: [id])
  reviewId   Int
  user       User     @relation(fields: [userId], references: [id]) // Usuario que reporta
  userId     Int
  reason     String
}

model Review {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  product     Product  @relation(fields: [productId], references: [id])
  productId   Int
  rating      Int
  description String
  date        DateTime @default(now())
  isHidden    Boolean  @default(false)
  reported    Boolean  @default(false)
  moderationRequests ReviewModerationRequest[]
}

model CustomProduct {
  id             Int                      @id @default(autoincrement())
  baseProduct    Product                  @relation(fields: [baseProductId], references: [id])
  baseProductId  Int
  customProducts CustomProductSelection[]
  orderItems     OrderItem[]
  totalPrice     Float
}

//CRITERIOS
model CustomOption {
  id     Int                 @id @default(autoincrement())
  name   String // Ej: "Color", "Talla", "Diseño"
  values CustomOptionValue[]
}

//valores asociados a los criterios
model CustomOptionValue {
  id         Int                      @id @default(autoincrement())
  value      String
  option     CustomOption             @relation(fields: [optionId], references: [id])
  optionId   Int
  price  Float               @default(0)
  selections CustomProductSelection[]
}

//Usuario seleccionó
model CustomProductSelection {
  id              Int               @id @default(autoincrement())
  customProduct   CustomProduct     @relation(fields: [customProductId], references: [id])
  customProductId Int
  optionValue     CustomOptionValue @relation(fields: [optionValueId], references: [id])
  optionValueId   Int
}

model Promotion {
  id         Int       @id @default(autoincrement())
  name       String
  type       PromoType
  amount     Float
  product    Product?  @relation(fields: [productId], references: [id])
  productId  Int?
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int?
  startDate  DateTime
  endDate    DateTime
}

enum PromoType {
  PERCENTAGE
  FIXED
}

model Order {
  id            Int              @id @default(autoincrement())
  user          User             @relation(fields: [userId], references: [id])
  userId        Int
  createdAt     DateTime         @default(now())
  status        OrderStatus      @default(PENDING_PAYMENT)
  items         OrderItem[]
  address       String
  paymentMethod String
  subtotal      Float
  total         Float
  statusLogs    OrderStatusLog[]
}

model OrderItem {
  id              Int            @id @default(autoincrement())
  order           Order          @relation(fields: [orderId], references: [id])
  orderId         Int
  product         Product?       @relation(fields: [productId], references: [id])
  productId       Int?
  customProduct   CustomProduct? @relation(fields: [customProductId], references: [id])
  customProductId Int?
  quantity        Int
}

enum OrderStatus {
  CART
  PENDING_PAYMENT
  PAID
  IN_PREPARATION
  DELIVERED
}

model OrderStatusLog {
  id        Int         @id @default(autoincrement())
  order     Order       @relation(fields: [orderId], references: [id])
  orderId   Int
  status    OrderStatus
  changedBy User        @relation("AdminChanges", fields: [adminId], references: [id])
  adminId   Int
  changedAt DateTime    @default(now())
}
